          "sql": "CREATE TABLE IF NOT EXISTS \"refreshes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"trigger\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT NOT NULL, \"outcome\" TEXT NOT NULL, \"added\" INTEGER NOT NULL DEFAULT 0, \"changed\" INTEGER NOT NULL DEFAULT 0, \"removed\" INTEGER NOT NULL DEFAULT 0, \"skipped\" INTEGER NOT NULL DEFAULT 0, \"config_version\" INTEGER NULL, \"error\" TEXT NULL, CHECK (trigger IN ('startup', 'interval', 'resumed', 'reconnect', 'manual')), CHECK (outcome IN ('updated', 'notModified', 'offline', 'failed', 'unauthorized')), CHECK (added >= 0 AND changed >= 0 AND removed >= 0 AND skipped >= 0), CHECK (started_at GLOB '*Z' AND finished_at GLOB '*Z'));"
